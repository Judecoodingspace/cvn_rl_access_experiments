{
  "inherits": "e2_d4a_joint_prediction_dqi_factorial.json",
  "validation_type": "d4a_mixed_mode_pilot",
  "slots": 8000,
  "quick_slots": 500,
  "seeds": [301, 302],
  "agents": ["ddqn_no_esn"],
  "num_channels": 10,
  "num_vehicles": 1,
  "arrival_probabilities": [0.35],
  "protection_variant": "gate_state_mask",
  "mask_policy_version": "d4a_mixed_mode_pilot_v1",
  "underlay_rate_model": "power_aware_v1",
  "action": {
    "enabled_modes": ["overlay", "underlay"]
  },
  "action_mask_thresholds": {
    "sensing_idle_min": 0.5,
    "overlay_theta_min": null,
    "underlay_power_cap_min": 0.0,
    "underlay_theta_min": null
  },
  "underlay_power": {
    "p_max_mw": 1.0,
    "fading_margin": 2.0,
    "service_power_ceiling_fraction": 0.2,
    "pu_to_su_interference_ratio": 1.0
  },
  "packet_traffic": {
    "family": "bernoulli",
    "arrival_probability": 0.35,
    "queue_capacity_packets": 10,
    "packet_size_bits": 32000
  },
  "traffic": {
    "family": "periodic_with_jitter",
    "period_slots": 50,
    "busy_slots": 20,
    "jitter_slots": 5,
    "sensing_pd": 0.9,
    "sensing_pfa": 0.1
  },
  "channel": {
    "snr_db_range": [-5, 30],
    "bandwidth_mhz": [10],
    "quality_family": "smooth_semi_markov",
    "fixed_bandwidth_mhz": 10.0
  },
  "checkpoint_evaluation": {
    "checkpoint_interval": 2000,
    "eval_episodes": 1,
    "eval_slots": 1000
  },
  "final_checkpoint_evaluation": {
    "eval_episodes": 2,
    "eval_slots": 2000
  },
  "expected_outputs": [
    "metrics/access_metrics.csv",
    "metrics/checkpoint_metrics.csv",
    "tables/checkpoint_summary.csv",
    "tables/final_checkpoint_results.csv",
    "tables/paired_bootstrap_comparisons.csv",
    "tables/runtime_summary.csv",
    "tables/evaluation_audit.csv",
    "manifest.json"
  ]
}
