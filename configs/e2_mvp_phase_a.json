{
  "inherits": "base_multi_vehicle.json",
  "experiment": "multi_vehicle_module_ablation",
  "e2_mvp_phase": "A",
  "slots": 30000,
  "quick_slots": 500,
  "seeds": [1, 2, 3],
  "agents": ["ddqn_no_esn"],
  "arrival_probabilities": [0.20],
  "protection_variant": "gate_state_mask",
  "validation_type": "synthetic_surrogate_mvp",
  "reporting_profile": "e2_pilot",
  "checkpoint_evaluation": {
    "checkpoint_interval": 1000,
    "eval_episodes": 5,
    "eval_slots": 1000
  },
  "module_conditions": [
    {
      "name": "legacy_full",
      "ablation_info_source": "real",
      "ablation_mask_source": "real",
      "mask_policy_version": "legacy_v1",
      "action_mask_thresholds": {
        "sensing_idle_min": 0.5,
        "overlay_theta_min": 0.35,
        "underlay_power_cap_min": 0.2,
        "underlay_theta_min": 0.2
      }
    },
    {
      "name": "revised_full",
      "ablation_info_source": "real",
      "ablation_mask_source": "real",
      "mask_policy_version": "e2_revised_v2",
      "action_mask_thresholds": {
        "sensing_idle_min": 0.5,
        "overlay_theta_min": 0.35,
        "underlay_power_cap_min": 0.2,
        "underlay_theta_min": null
      }
    },
    {
      "name": "no_prediction_info",
      "ablation_info_source": "neutral",
      "ablation_mask_source": "real",
      "mask_policy_version": "e2_revised_v2",
      "action_mask_thresholds": {
        "sensing_idle_min": 0.5,
        "overlay_theta_min": 0.35,
        "underlay_power_cap_min": 0.2,
        "underlay_theta_min": null
      }
    },
    {
      "name": "prediction_mask_ablation",
      "ablation_info_source": "real",
      "ablation_mask_source": "neutral",
      "mask_policy_version": "e2_revised_v2",
      "action_mask_thresholds": {
        "sensing_idle_min": 0.5,
        "overlay_theta_min": 0.35,
        "underlay_power_cap_min": 0.2,
        "underlay_theta_min": null
      }
    }
  ],
  "scenarios": [
    {
      "name": "M3_high_pu",
      "num_channels": 3,
      "num_vehicles": 1,
      "traffic": {
        "family": "fixed_markov",
        "p01": 0.3,
        "p10": 0.1,
        "sensing_pd": 0.9,
        "sensing_pfa": 0.1
      }
    }
  ],
  "expected_outputs": [
    "metrics/e2_mvp_phase_a_checkpoint_metrics.csv",
    "tables/e2_mvp_phase_a_summary.csv"
  ]
}
