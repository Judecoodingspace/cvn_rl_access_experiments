  "expected_outputs": [
    "metrics/access_metrics.csv",
    "tables/summary_by_agent.csv",
    "figures/rl_baseline_plr_ieee.pdf",
    "figures/rl_baseline_pu_violation_ieee.pdf"
  ]
}
