{
  "inherits": "base.json",
  "experiment": "multi_vehicle_baseline_comparison",
  "slots": 30000,
  "quick_slots": 500,
  "traffic": {
    "family": "fixed_markov",
    "p01": 0.2,
    "p10": 0.2,
    "sensing_pd": 0.9,
    "sensing_pfa": 0.1
  },
  "packet_traffic": {
    "family": "bernoulli",
    "arrival_probability": 0.2,
    "queue_capacity_packets": 10,
    "packet_size_bits": 32000
  },
  "descriptors": {
    "source": "generated",
    "require_frozen_models": false,
    "persist_generated_bundles": false,
    "dqi_update_slots": 1000,
    "dqi_history_slots": 60000,
    "prediction_history_slots": 50,
    "prediction_noise_std": 0.03,
    "dqi_model_id": "causal_quantile_dqi_surrogate",
    "prediction_model_id": "causal_attention_lstm_surrogate"
  },
  "dqi": {
    "r_ref_mbps": 80,
    "packet_size_bits": 32000,
    "delay_max_ms": 5.0,
    "delay_beta_ms": 2.0,
    "validity": {
      "t_min_slots": 100,
      "t_max_slots": 1000,
      "discount": "exp(-age / T_val)"
    }
  },
  "reward": {
    "type": "physical",
    "service_weight": 1.0,
    "drop_weight": 1.0,
    "contention_weight": 0.25,
    "violation_weight": 2.0,
    "queue_weight": 0.05,
    "clip_reward": [-3.0, 2.0]
  },
  "checkpoint_evaluation": {
    "checkpoint_interval": 1000,
    "eval_episodes": 10,
    "eval_slots": 1000
  },
  "expected_outputs": [
    "metrics/checkpoint_metrics.csv",
    "tables/checkpoint_summary.csv",
    "figures/reward_checkpoint_convergence.pdf",
    "figures/vt_throughput_checkpoint_convergence.pdf",
    "figures/safety_throughput_pareto.pdf",
    "figures/performance_vs_load.pdf",
    "figures/underlay_ratio.pdf",
    "figures/plr_decomposition.pdf"
  ]
}
