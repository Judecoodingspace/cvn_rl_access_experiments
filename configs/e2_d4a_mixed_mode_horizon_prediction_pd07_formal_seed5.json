      "prediction_plus_dqi_plr_le_prediction_only": true,
      "prediction_plus_dqi_pu_violation_le_dqi_only": true,
      "prediction_plus_dqi_goodput_margin_vs_dqi_only_min_mbps": -0.25,
      "prediction_plus_dqi_underlay_selection_ratio_min": 0.45
