    {
      "name": "theta_placebo_b",
      "descriptors": {
        "theta_condition": "time_shuffled",
        "theta_shuffle_seed_offset": 1000003,
        "dqi_condition": "neutral"
      }
    },
    {
      "name": "theta_neutral",
      "descriptors": {
        "theta_condition": "neutral",
        "dqi_condition": "neutral"
      }
    }
  ],
  "gate_conditions": {
    "oracle": "theta_oracle",
    "primary_placebo": "theta_placebo_a",
    "replicate_placebo": "theta_placebo_b",
    "neutral": "theta_neutral"
