{
  "inherits": "base_multi_vehicle.json",
  "experiment": "multi_vehicle_baseline_comparison",
  "slots": 30000,
  "seeds": [1, 2, 3, 4, 5],
  "agents": [
    "proposed_esn_ddqn",
    "dqn",
    "ddqn_no_esn",
    "lstm_ddqn",
    "sac_discrete",
    "ppo_discrete",
    "tabular_q_learning",
    "independent_ddqn",
    "fixed_overlay",
    "fixed_underlay"
  ],
  "agent_settings": {
    "lstm_ddqn": {
      "hidden_size": 128,
      "sequence_length": 32,
      "burn_in": 8,
      "learning_rate": 0.001,
      "warmup": 512
    },
    "sac_discrete": {
      "hidden_dim": 128,
      "learning_rate": 0.0003,
      "tau": 0.005,
      "initial_alpha": 0.2,
      "target_entropy_scale": 0.98,
      "update_every": 4,
      "warmup": 512
    }
  },
  "module_variant": "full",
  "protection_variant": "gate_state_mask",
  "validation_type": "synthetic_controlled",
  "packet_traffic": {"arrival_probability": 0.2, "queue_capacity_packets": 10, "packet_size_bits": 32000},
  "final_checkpoint_evaluation": {
    "eval_episodes": 5,
    "eval_slots": 5000
  },
  "scenarios": [
    {
      "name": "M10_N10_competitive",
      "num_channels": 10,
      "num_vehicles": 10,
      "traffic": {"family": "fixed_markov", "p01": 0.2, "p10": 0.2, "sensing_pd": 0.9, "sensing_pfa": 0.1},
      "packet_traffic": {"family": "bernoulli", "arrival_probability": 0.5, "queue_capacity_packets": 10, "packet_size_bits": 32000}
    },
    {
      "name": "M15_N10_abundant",
      "num_channels": 15,
      "num_vehicles": 10,
      "traffic": {"family": "fixed_markov", "p01": 0.1, "p10": 0.3, "sensing_pd": 0.9, "sensing_pfa": 0.1}
    }
  ],
  "pilot_gate": {
    "enabled": true,
    "agents": ["independent_ddqn", "ddqn_no_esn"],
    "module_variants": ["full"],
    "access_ratio_range": [0.05, 0.95],
    "scarce_contention_loss_max": 0.7,
    "light_queue_fraction_max": 1.0
  }
}
