{
  "inherits": "base_multi_vehicle.json",
  "experiment": "multi_vehicle_module_ablation",
  "e2_mvp_phase": "C",
  "requires_pilot_gate": true,
  "slots": 30000,
  "quick_slots": 500,
  "seeds": [1, 2, 3],
  "agents": ["ddqn_no_esn"],
  "arrival_probabilities": [0.20, 0.35],
  "protection_variant": "gate_state_mask",
  "validation_type": "synthetic_surrogate_mvp",
  "reporting_profile": "e2_pilot",
  "mask_policy_version": "e2_revised_v2",
  "action_mask_thresholds": {
    "sensing_idle_min": 0.5,
    "overlay_theta_min": 0.35,
    "underlay_power_cap_min": 0.2,
    "underlay_theta_min": null
  },
  "checkpoint_evaluation": {
    "checkpoint_interval": 1000,
    "eval_episodes": 5,
    "eval_slots": 1000
  },
  "module_conditions": [
    {"name": "full", "ablation_info_source": "real", "ablation_mask_source": "real"},
    {"name": "no_dqi", "ablation_info_source": "real", "ablation_mask_source": "real"},
    {"name": "no_prediction_info", "ablation_info_source": "neutral", "ablation_mask_source": "real"},
    {"name": "state_sensing_only", "ablation_info_source": "neutral", "ablation_mask_source": "real"}
  ],
  "reuse_module_aliases": {
    "full": "revised_full"
  },
  "require_reuse_cases": [
    {"scenario": "M3_high_pu", "arrival_probability": 0.20, "module_variant": "full"},
    {"scenario": "M3_high_pu", "arrival_probability": 0.20, "module_variant": "no_prediction_info"}
  ],
  "scenarios": [
    {
      "name": "M3_high_pu",
      "num_channels": 3,
      "num_vehicles": 1,
      "traffic": {"family": "fixed_markov", "p01": 0.3, "p10": 0.1, "sensing_pd": 0.9, "sensing_pfa": 0.1}
    },
    {
      "name": "M10_low_pu",
      "num_channels": 10,
      "num_vehicles": 1,
      "traffic": {"family": "fixed_markov", "p01": 0.1, "p10": 0.3, "sensing_pd": 0.9, "sensing_pfa": 0.1}
    }
  ],
  "expected_outputs": [
    "metrics/e2_mvp_phase_c_checkpoint_metrics.csv",
    "tables/e2_mvp_phase_c_summary.csv"
  ]
}
